"""
Type Stubs for sl_mysql.silo_cursor

This module declares SL1's database entry point. The shapes were established by inspecting the
running platform, since there is no documentation:

- ``local_db(cursorclass=silo_cursor)`` calls
  ``get_dbc(**get_dbparams('LOCAL'), cursorclass=cursorclass)``.
- ``local_db()`` does not go through ``@cache_connections``: two calls return two distinct
  connections. That makes a thread-affine connection store safe, which matters because
  ``MySQLdb.threadsafety`` is ``1``.
- The returned object is itself cursor-like and carries ``.connection``.

``Row`` is ``tuple[object, ...]`` rather than ``tuple[Any, ...]``; see the package docstring.
"""

from collections.abc import Mapping, Sequence
from types import TracebackType

Row = tuple[object, ...]

class _Connection:
    """The underlying connection. Only what this service needs is declared.

    Its real type is ``sl_mysql.connect.silo_db``, which also has ``commit``, ``rollback``,
    ``autocommit`` and ``get_autocommit``. Those are deliberately not declared. ``@@autocommit``
    is ``1`` on this platform, so the service never commits explicitly, and disabling autocommit
    on a platform-owned connection would change behaviour for everything else it serves.
    """

    def close(self) -> None: ...
    def ping(self, reconnect: bool = ...) -> None: ...

class silo_cursor:  # noqa: N801 -- platform's own name, not ours to style
    """Platform cursor. ``local_db()`` returns one of these.

    Passing ``args`` to ``execute`` changes SQL rendering: MySQLdb applies ``sql % args`` whenever
    ``args`` is not ``None``, so a literal ``%`` in the statement becomes a format specifier. On
    this platform the resulting error is not raised; the call returns no rows instead. Never leave
    a literal ``%`` in statement text; bind patterns as parameters.
    """

    connection: _Connection

    # Rows affected by the last statement. Present on the running platform.
    rowcount: int

    # Auto-increment id generated by the last ``INSERT``. Lets ``sl1_simulate_event`` report its
    # new event id without a second ``SELECT LAST_INSERT_ID()``.
    lastrowid: int

    def execute(
        self, query: str, args: Sequence[object] | Mapping[str, object] | None = ...
    ) -> object: ...
    def fetchall(self) -> tuple[Row, ...]: ...
    def fetchone(self) -> Row | None: ...
    def close(self) -> None: ...
    def __enter__(self) -> silo_cursor: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        tb: TracebackType | None,
    ) -> None: ...

def local_db(cursorclass: type[silo_cursor] = ...) -> silo_cursor: ...
